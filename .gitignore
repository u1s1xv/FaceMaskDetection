# ============================================================================
# FaceMaskDetection .gitignore
# ============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class

# ---- 编辑器 / IDE ----
.vscode/
.idea/
.VSCodeCounter/
*.user
*.user.*

# ---- 运行期数据 ----
# 推理服务的历史库（SQLite）与上传原图，属于运行产物不入库
/data/

# ---- 数据集与日志：只保留目录骨架（.keep），内容不入库 ----
yoloserver/data/*
!yoloserver/data/.keep
!yoloserver/data/*/.keep
!yoloserver/data/*/*/.keep
!yoloserver/data/crawled

yoloserver/logs/*
!yoloserver/logs/.keep
!yoloserver/logs/*/.keep

yoloserver/configs/*
!yoloserver/configs/.keep

yoloserver/runs/*
!yoloserver/runs/.keep

# ---- C++/Qt 客户端构建产物 ----
client/build/
client/build-*/
client/dist/
client/tests/build/

# ---- 自检 / 冒烟 / 基准测试产物 ----
client/*.out
client/*.err
client/*.log
