# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.VSCodeCounter/

# Data directories - ignore large datasets but keep structure
yoloserver/data/*
!yoloserver/data/.keep
!yoloserver/data/*/.keep
!yoloserver/data/*/*/.keep
!yoloserver/data/crawled

# Logs directories
yoloserver/logs/*
!yoloserver/logs/.keep
!yoloserver/logs/*/.keep

# Configs directories
yoloserver/configs/*
!yoloserver/configs/.keep

# Runs directories
yoloserver/runs/*
!yoloserver/runs/.keep

# Django Media directories
django_frontend/media/*
!django_frontend/media/.keep

# Django sqlite database
django_frontend/db.sqlite3

# Qt/C++ client build artifacts
client/build/
client/build-*/
client/dist/
client/tests/build/
*.user
*.user.*

# 运行期数据（SQLite 历史库 + 上传原图），不入库
/data/

# 自检/冒烟测试产物
client/*.out
client/*.err
client/*.log
client/probe.py